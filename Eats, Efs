import numpy as np
import matplotlib.pyplot as plt

def plot_surfaces():
    beta_values = [0.1, 0.3, 0.5, 0.7, 0.9]
    colors = ['blue', 'orange', 'green', 'red', 'purple']
    
    fig, axes = plt.subplots(1, 3, figsize=(24, 8))
    
    p_bar = np.linspace(0, 1.0, 1000)
    
    scenarios = [
        (axes[0], -0.5, r"Redshifted EFS ($x = -0.5$)"),
        (axes[1],  0.5, r"Blueshifted EFS ($x = +0.5$)")
    ]
    
    for ax, x_val, title in scenarios:
        for i, beta_max in enumerate(beta_values):
            nu_ratio = 1.0 + x_val * beta_max
            A = (1.0 / nu_ratio)**2
            
            beta_p = p_bar * beta_max
            
            a = 1.0 + A
            b = -2.0
            c_coef = 1.0 - A * (1.0 - beta_p**2)
            
            discriminant = b**2 - 4.0 * a * c_coef
            valid = discriminant >= 0
            
            beta_z_1 = (-b - np.sqrt(np.maximum(discriminant, 0))) / (2.0 * a)
            z_bar = beta_z_1 / beta_max
                
            inside_ejecta = (p_bar**2 + z_bar**2) <= 1.0001
            mask = valid & inside_ejecta
            
            ax.plot(p_bar[mask], z_bar[mask], '-', color=colors[i], linewidth=2.5, label=r'$\beta_{\max} = ' + str(beta_max) + '$')
            
            z_classic = (1.0 - 1.0 / nu_ratio) / beta_max
            p_max_classic = np.sqrt(max(1.0 - z_classic**2, 0))
            p_classic_arr = p_bar[p_bar <= p_max_classic]
            z_classic_arr = np.ones_like(p_classic_arr) * z_classic
            
            ax.plot(p_classic_arr, z_classic_arr, ':', color=colors[i], linewidth=1.5)
            
        ax.plot(p_bar, np.sqrt(1.0 - p_bar**2), 'k--', linewidth=1, alpha=0.7)
        ax.plot(p_bar, -np.sqrt(1.0 - p_bar**2), 'k--', linewidth=1, alpha=0.7)
        
        ax.axhline(0, color='black', linewidth=1)
        ax.axvline(0, color='black', linewidth=1)
        
        ax.set_title(title, fontsize=16)
        ax.set_xlabel(r'$p / R_{\max}$', fontsize=14)
        ax.set_ylabel(r'$z / R_{\max}$', fontsize=14)
        ax.set_aspect('equal', adjustable='box')
        ax.grid(True, linestyle=':', alpha=0.6)
        ax.set_ylim(-1.1, 1.1)
        ax.legend(bbox_to_anchor=(1.05, 1), loc='upper left', fontsize=12)

    ax_eats = axes[2]
    beta_eats_values = [0.1, 0.3, 0.6, 0.9]
    colors_eats = ['blue', 'orange', 'green', 'red']
    
    for i, beta in enumerate(beta_eats_values):
        gamma = 1.0 / np.sqrt(1.0 - beta**2)
        p_tilde = np.linspace(0, gamma, 500)
        
        discriminant = 1.0 - p_tilde**2 * (1.0 - beta**2)
        valid = discriminant >= 0
        p_valid = p_tilde[valid]
        disc_valid = discriminant[valid]
        
        z_tilde_plus = (beta + np.sqrt(disc_valid)) / (1.0 - beta**2)
        z_tilde_minus = (beta - np.sqrt(disc_valid)) / (1.0 - beta**2)
        
        p_classic = np.linspace(0, 1.0, 500)
        z_classic_plus = np.sqrt(1.0 - p_classic**2)
        z_classic_minus = -np.sqrt(1.0 - p_classic**2)
        
        ax_eats.plot(p_valid, z_tilde_plus, '-', color=colors_eats[i], linewidth=2.5, label=r'Relativistic ($\beta=' + str(beta) + '$)')
        ax_eats.plot(p_valid, z_tilde_minus, '-', color=colors_eats[i], linewidth=2.5)
        
        if i == 0:
            ax_eats.plot(p_classic, z_classic_plus, ':', color='gray', linewidth=1.5, label='Classical (Sphere)')
            ax_eats.plot(p_classic, z_classic_minus, ':', color='gray', linewidth=1.5)
        else:
            ax_eats.plot(p_classic, z_classic_plus, ':', color='gray', linewidth=1.5)
            ax_eats.plot(p_classic, z_classic_minus, ':', color='gray', linewidth=1.5)

    ax_eats.annotate('Observer\n$\\rightarrow +z$', xy=(0.5, 0.90), xycoords='axes fraction', fontsize=13, ha='center', bbox=dict(boxstyle="round,pad=0.3", fc="white", ec="gray", lw=1))
    
    ax_eats.set_title(r"Equal Arrival Time Surface (EATS)", fontsize=16)
    ax_eats.set_xlabel(r'Normalized Impact Parameter $p / (v t_{\mathrm{obs}})$', fontsize=14)
    ax_eats.set_ylabel(r'Normalized Line of Sight $z / (v t_{\mathrm{obs}})$', fontsize=14)
    
    ax_eats.axhline(0, color='black', linewidth=1)
    ax_eats.axvline(0, color='black', linewidth=1)
    ax_eats.grid(True, linestyle=':', alpha=0.6)
    ax_eats.set_aspect('equal', adjustable='datalim')
    ax_eats.legend(bbox_to_anchor=(1.05, 1), loc='upper left', fontsize=12)
    
    plt.tight_layout()
    plt.show()

if __name__ == "__main__":
    plot_surfaces()
